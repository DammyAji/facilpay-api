<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 0; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; }
    .header { background: #4F46E5; color: white; padding: 24px; border-radius: 8px 8px 0 0; text-align: center; }
    .header h1 { margin: 0; font-size: 22px; }
    .header p { margin: 4px 0 0; opacity: 0.85; font-size: 13px; }
    .body { background: #fff; padding: 24px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 8px 8px; }
    .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 20px 0; }
    .stat { background: #f9fafb; border-radius: 6px; padding: 14px 16px; }
    .stat-label { font-size: 11px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: 0.05em; }
    .stat-value { font-size: 24px; font-weight: 700; color: #111827; margin-top: 2px; }
    .stat-value.green { color: #059669; }
    .stat-value.red { color: #dc2626; }
    .divider { border: none; border-top: 1px solid #e5e7eb; margin: 20px 0; }
    .footer { text-align: center; font-size: 12px; color: #9ca3af; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e5e7eb; }
    .footer a { color: #4F46E5; text-decoration: none; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>{{frequency}} Report</h1>
      <p>{{periodStart}} – {{periodEnd}}</p>
    </div>
    <div class="body">
      <p>Here's your payment summary for the period above.</p>

      <div class="stat-grid">
        <div class="stat">
          <div class="stat-label">Total Volume</div>
          <div class="stat-value green">{{totalVolume}} {{currency}}</div>
        </div>
        <div class="stat">
          <div class="stat-label">Net Amount</div>
          <div class="stat-value green">{{totalNetAmount}} {{currency}}</div>
        </div>
        <div class="stat">
          <div class="stat-label">Fees</div>
          <div class="stat-value">{{totalFees}} {{currency}}</div>
        </div>
        <div class="stat">
          <div class="stat-label">Refunds</div>
          <div class="stat-value red">{{totalRefunds}} {{currency}}</div>
        </div>
        <div class="stat">
          <div class="stat-label">Total Payments</div>
          <div class="stat-value">{{totalPayments}}</div>
        </div>
        <div class="stat">
          <div class="stat-label">Completed</div>
          <div class="stat-value">{{completedPayments}}</div>
        </div>
      </div>

      {{#if refundCount}}
      <p style="font-size:13px;color:#6b7280;">{{refundCount}} refund(s) totalling {{totalRefunds}} {{currency}} were issued in this period.</p>
      {{/if}}

      <hr class="divider">

      {{#if attachments}}
      <p style="font-size:13px;">A CSV of your payments for this period is attached.</p>
      {{/if}}

      <p><a href="{{appUrl}}" style="color:#4F46E5;">View dashboard</a></p>
    </div>
    <div class="footer">
      <p>&copy; {{year}} FacilPay. All rights reserved.</p>
      {{#if unsubscribeUrl}}
      <p><a href="{{unsubscribeUrl}}">Unsubscribe from these reports</a></p>
      {{/if}}
    </div>
  </div>
</body>
</html>
